# EchoMind environment variables
# Copy this file to .env and edit the values.
# All variables are optional — EchoMind works with sensible defaults.

# ---- Local LLM (Ollama) ----
ECHOMIND_MODEL=llama3.2:3b

# ---- Online features ----
ECHOMIND_FACTS=1                       # 1 = allow weather + Wikipedia lookups
ECHOMIND_FOLLOWUP=10                   # seconds: no wake word needed right after a reply
ECHOMIND_CALENDAR=1                    # 1 = enable Google Calendar sync (needs credentials.json)

# ---- Speech recognition ----
ECHOMIND_STT=auto                      # auto | whisper | vosk
ECHOMIND_STT_MODEL=base.en             # faster-whisper model: tiny.en, base.en, small.en
# ECHOMIND_VOSK=/path/to/vosk-model    # override Vosk model directory

# ---- Microphone ----
# ECHOMIND_MIC=                        # device index or name substring
# ECHOMIND_MIC_BACKEND=auto            # auto | alsa | parec | sd
# ECHOMIND_MIC_VOLUME=                 # capture volume percentage (PulseAudio)
# ECHOMIND_ALSA_DEVICE=                # e.g. plughw:2,0
# ECHOMIND_SOURCE=                     # PulseAudio source name
# ECHOMIND_VAD_MIN=220                 # minimum energy level for voice activity detection

# ---- Raspberry Pi GPIO ----
ECHOMIND_SWITCH_MODE=push              # push (momentary) or toggle (real on/off switches)

# ---- Documents (RAG) ----
# ECHOMIND_DOCS=./documents            # path to your PDF/text documents folder

# ---- Optional: email digest ----
ECHOMIND_MAIL=0
ECHOMIND_IMAP_HOST=imap.gmail.com
ECHOMIND_MAIL_USER=your_email@gmail.com
ECHOMIND_MAIL_PASS=your_app_password

# ---- Optional: GitHub overview ----
ECHOMIND_GITHUB=0
ECHOMIND_GITHUB_USER=your_github_username
ECHOMIND_GITHUB_TOKEN=ghp_your_read_only_token

# ---- Debug ----
# ECHOMIND_DEBUG_MIC=1                 # verbose mic/VAD output
# ECHOMIND_DEBUG_RAG=1                 # verbose document retrieval output
